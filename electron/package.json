{
  "name": "dashboard",
  "version": "1.0.0",
  "description": "Personal dashboard — Electron wrapper for Flask",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.ryanhogan.dashboard",
    "productName": "Dashboard",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "icon": "icon.icns"
    },
    "asar": false,
    "files": [
      "main.js",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../flask_app",
        "to": "flask_app",
        "filter": [
          "**/*",
          "!.venv/**",
          "!__pycache__/**",
          "!*.pyc"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
